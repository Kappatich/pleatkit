{
  "name": "@pleatkit/evals",
  "private": true,
  "version": "0.1.0",
  "description": "Eval harness for the pleatkit agent: tasks, graders, replay, baseline and report (brainstorm 04 §8 items 3, 9, 11)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "record": "tsx src/cli.ts record",
    "replay": "tsx src/cli.ts replay",
    "sanity": "tsx src/cli.ts sanity",
    "pin": "tsx src/cli.ts pin",
    "report": "tsx src/cli.ts report",
    "classify": "tsx src/classifier-probe.ts",
    "summarize": "tsx src/summarize.ts",
    "cancel": "tsx src/cancel-probe.ts",
    "judge": "tsx src/cli.ts judge",
    "chains": "tsx src/cli.ts chains",
    "weekly": "tsx src/weekly.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@pleatkit/agent": "workspace:*",
    "@pleatkit/runtime": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
