{
  "name": "@morphkit/agent",
  "version": "0.1.0",
  "description": "Agent server for morphkit: model loop with zone-checked file tools, server-side esbuild check, SSE progress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kappatich/morphkit.git",
    "directory": "packages/agent"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "morphkit-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/node-server": "^1.19.5",
    "@morphkit/runtime": "workspace:*",
    "esbuild": "0.28.2",
    "hono": "^4.10.0",
    "typescript": "~5.9.3",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
