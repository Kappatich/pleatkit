{
  "name": "@pleatkit/agent",
  "version": "0.3.0",
  "description": "Agent server for pleatkit: model loop with zone-checked file tools, server-side esbuild check, SSE progress",
  "license": "MIT",
  "homepage": "https://github.com/Kappatich/pleatkit/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/Kappatich/pleatkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kappatich/pleatkit.git",
    "directory": "packages/agent"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pleatkit-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/node-server": "^1.19.5",
    "@pleatkit/runtime": "workspace:*",
    "esbuild": "0.28.2",
    "hono": "^4.10.0",
    "typescript": "~5.9.3",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "vitest": "^3.2.4",
    "esbuild-wasm": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
