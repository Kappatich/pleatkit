{
  "name": "@pleatkit/ui",
  "version": "0.1.0",
  "description": "Chat drawer, element picker, history and toasts for pleatkit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kappatich/pleatkit.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@pleatkit/runtime": "workspace:^",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@pleatkit/runtime": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
