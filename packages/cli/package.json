{
  "name": "@pleatkit/cli",
  "version": "0.3.0",
  "description": "pleatkit command line: `pleatkit doctor` checks an app's setup, `pleatkit keys` makes app keys, `pleatkit export` exports data",
  "license": "MIT",
  "homepage": "https://github.com/Kappatich/pleatkit/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/Kappatich/pleatkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kappatich/pleatkit.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pleatkit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pleatkit/vite-plugin": "workspace:*",
    "tinyglobby": "^0.2.15",
    "@pleatkit/runtime": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "@pleatkit/agent": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pleatkit/agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "@pleatkit/agent": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
