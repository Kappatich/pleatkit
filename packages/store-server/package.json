{
  "name": "@pleatkit/store-server",
  "version": "0.4.0",
  "description": "The open pleatkit store (MIT): per-user snapshots and heads, signed bundles, the agent request log, quotas, usage events, the audit chain, roles, flags and the kill switch, releases, code search, erasure (Hono + Drizzle + SQLite)",
  "license": "MIT",
  "homepage": "https://github.com/Kappatich/pleatkit/tree/main/packages/store-server#readme",
  "bugs": {
    "url": "https://github.com/Kappatich/pleatkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kappatich/pleatkit.git",
    "directory": "packages/store-server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pleatkit-store": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./token": {
      "types": "./dist/token.d.ts",
      "import": "./dist/token.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.0",
    "@pleatkit/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
