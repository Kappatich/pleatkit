{
  "name": "@pleatkit/runtime",
  "version": "0.3.0",
  "description": "Browser runtime for pleatkit: snapshots, esbuild-wasm compiler, hot swap of dynamic React components, undo/redo",
  "license": "MIT",
  "homepage": "https://github.com/Kappatich/pleatkit/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/Kappatich/pleatkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kappatich/pleatkit.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler-entry.d.ts",
      "import": "./dist/compiler-entry.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js"
    },
    "./isolated-host": {
      "types": "./dist/isolated-host.d.ts",
      "import": "./dist/isolated-host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-jsx": "^5.3.2",
    "esbuild-wasm": "0.28.2",
    "idb": "^8.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
