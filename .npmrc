# No tokens in this file, ever (V1 A6). Provenance is not forced here: npm can attest a package only when it is
# published from a supported CI (the release workflow passes --provenance itself), and the first, hand-run
# publish of 0.4.0 from the founder's machine would fail with it. See docs/RELEASING.md.
# never fall back to a token from the environment of a coding agent
always-auth=false
