# /etc/pleatkit-demo/demo.env (root:pleatkit-demo, mode 0640). Never commit the real file. docs/demo-hosting.md.

# scripted (default, no model cost) or live (free text goes to the model within the budget below)
DEMO_MODE=scripted

# LIVE only: the operator's Anthropic key. Read by the server process only; never logged, never sent to the browser.
# PLEATKIT_API_KEY=
# PLEATKIT_MODEL=claude-sonnet-5-5
# PLEATKIT_CLASSIFIER_MODEL=claude-haiku-5-5

# LIVE budget (UTC day). At 80 % of the dollar cap a warning goes to the journal; a run starts only while its
# worst case (DEMO_LIVE_MAX_USD_PER_REQUEST) still fits under the cap, after that free text gets the scripted fallback.
DEMO_DAILY_USD=5
DEMO_DAILY_LIVE_REQUESTS=100
DEMO_VISITOR_LIVE_REQUESTS=5
DEMO_VISITOR_IP_FACTOR=3
DEMO_LIVE_MAX_USD_PER_REQUEST=0.40
DEMO_LIVE_CONCURRENCY=2

# pace of the recorded answers, sandbox lifetime, log retention
DEMO_SCRIPTED_DELAY_MS=900
DEMO_VISITOR_TTL_HOURS=24
DEMO_MAX_VISITORS=2000
DEMO_RETENTION_DAYS=30

# links on the page
DEMO_CONTACT_EMAIL=pilot@pleatkit.com
DEMO_SITE_URL=https://pleatkit.com
DEMO_FILM_URL=https://pleatkit.com/#demo
