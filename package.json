{
  "name": "pleatkit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @pleatkit/demo-crm e2e",
    "dev": "pnpm build:packages && node scripts/with-env.mjs pnpm --filter @pleatkit/demo-crm dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "dev:smoke": "pnpm build:packages && node scripts/dev-smoke.mjs",
    "agent:live": "node scripts/with-env.mjs node scripts/anthropic-live.mjs",
    "e2e:live": "node scripts/with-env.mjs pnpm --filter @pleatkit/demo-crm e2e live-anthropic",
    "demo:video": "pnpm build:packages && node scripts/record-demo.mjs",
    "site:check": "node scripts/site-check.mjs",
    "pleatkit-doctor": "node packages/cli/dist/cli.js doctor --root apps/demo-crm",
    "eval:record": "node scripts/with-env.mjs pnpm --filter @pleatkit/evals record",
    "eval:replay": "pnpm --filter @pleatkit/evals replay",
    "eval:sanity": "pnpm --filter @pleatkit/evals sanity",
    "eval:pin": "pnpm --filter @pleatkit/evals pin",
    "eval:report": "pnpm --filter @pleatkit/evals report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "undici": "^7.30.1"
  }
}
